# Local development. Copy to .env. These values are NOT production credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./data/learnsphere.db
SECRET_KEY=development-only-change-before-production-123456789
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=false
REQUIRE_PRIVILEGED_MFA=false
ACCESS_MINUTES=10
REFRESH_DAYS=7
STORAGE_PATH=./storage
UPLOAD_MAX_MB=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=learnsphere@example.com
SMTP_STARTTLS=true
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
