# Copy to .env.production. Generate unique secrets with: python -m app.cli generate-secrets
APP_ENV=production
POSTGRES_DB=learnsphere
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=CHANGE_ME_URLSAFE_RANDOM
SECRET_KEY=CHANGE_ME_RANDOM_AT_LEAST_48_CHARACTERS
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
FRONTEND_URL=https://learn.example.com
CORS_ORIGINS=https://learn.example.com
DEMO_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=true
REQUIRE_PRIVILEGED_MFA=true
ACCESS_MINUTES=10
REFRESH_DAYS=7
STORAGE_PATH=/app/storage
UPLOAD_MAX_MB=20
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=learning@example.com
SMTP_STARTTLS=true
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
